# Vortex environment configuration
#
# Copy this file to .env in the root of the project to override the default values.
#  -> cp .env_default .env
#
# The default below connects MAVSDK to PX4 SITL.
# For a real Raspberry Pi connected to a Pixhawk, use something like:
# DRONE_ADDRESS=serial:///dev/serial0:921600

DRONE_ADDRESS=udpin://0.0.0.0:14540